const CACHE_NAME = 'luma-admin-cache-v1';
const urlsToCache = [
  '/admin.html',
  '/manifest.json',
  '/icon-192x192.png',
  '/icon-512x512.png'
];

// Service Worker Install karna aur files cache karna
self.addEventListener('install', event => {
  event.waitUntil(
    caches.open(CACHE_NAME)
      .then(cache => {
        console.log('Opened cache');
        return cache.addAll(urlsToCache);
      })
  );
});

// Network requests ko intercept karna
self.addEventListener('fetch', event => {
  event.respondWith(
    caches.match(event.request)
      .then(response => {
        // Agar file cache mein hai toh wahan se dein, warna internet se fetch karein
        return response || fetch(event.request);
      })
  );
});

// Purane caches ko clean karna
self.addEventListener('activate', event => {
  const cacheWhitelist = [CACHE_NAME];
  event.waitUntil(
    caches.keys().then(cacheNames => {
      return Promise.all(
        cacheNames.map(cacheName => {
          if (cacheWhitelist.indexOf(cacheName) === -1) {
            return caches.delete(cacheName);
          }
        })
      );
    })
  );
});
